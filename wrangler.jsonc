{
  "name": "maze-rescue-game",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-02",
  "triggers": {
    "crons": ["0 0 * * *"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maze-rescue",
      "database_id": "14d9c244-5db2-45c5-b9e9-2d9278e8a419"
    }
  ]
}
